# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Database (if using TypeORM with SQLite for development)
DB_TYPE=sqlite
DB_NAME=viral-master.sqlite

# Seedance API
SEEDANCE_API_BASE_URL=https://api.console.seedance.com
SEEDANCE_API_KEY=your-seedance-api-key
SEEDANCE_WEBHOOK_SECRET=your-webhook-secret

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600
